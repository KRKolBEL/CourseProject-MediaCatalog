<Window x:Class="MediaCatalog.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Домашняя Медиатека (Курсовой проект)" Height="650" Width="950" WindowStartupLocation="CenterScreen">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Панель добавления -->
		<GroupBox Header="Добавить новый элемент" Grid.Row="0" Margin="0,0,0,10">
			<Grid Margin="5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="150"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="60"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="150"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,5,0"/>
				<ComboBox x:Name="CmbType" Grid.Column="1" SelectedIndex="0" SelectionChanged="CmbType_SelectionChanged">
					<ComboBoxItem Content="Фильм"/>
					<ComboBoxItem Content="Книга"/>
					<ComboBoxItem Content="Игра"/>
				</ComboBox>

				<TextBlock Text="Название:" VerticalAlignment="Center" Margin="10,0,5,0" Grid.Column="2"/>
				<TextBox x:Name="TxtTitle" Grid.Column="3"/>

				<TextBlock Text="Год:" VerticalAlignment="Center" Margin="10,0,5,0" Grid.Column="4"/>
				<TextBox x:Name="TxtYear" Grid.Column="5"/>

				<TextBlock Text="Жанр:" VerticalAlignment="Center" Margin="10,0,5,0" Grid.Column="6"/>
				<TextBox x:Name="TxtGenre" Grid.Column="7"/>

				<TextBlock x:Name="LblExtra" Text="Доп. инфо:" VerticalAlignment="Center" Margin="10,0,5,0" Grid.Column="8"/>
				<TextBox x:Name="TxtExtra" Grid.Column="9" ToolTip="Режиссер / Автор / Платформа"/>

				<Button Content="Добавить" Grid.Column="10" Width="80" Margin="10,0,0,0" Click="BtnAdd_Click"/>
			</Grid>
		</GroupBox>

		<!-- Поиск -->
		<StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
			<TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
			<TextBox x:Name="TxtSearch" Width="250" TextChanged="TxtSearch_TextChanged"/>
			<TextBlock Text="(по названию или жанру)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
		</StackPanel>

		<!-- Таблица -->
		<DataGrid x:Name="DgItems" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" AlternatingRowBackground="#F0F0F0">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Тип" Binding="{Binding MediaType}" Width="80"/>
				<DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
				<DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60"/>
				<DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="120"/>
				<DataGridTextColumn Header="Доп. инфо" Binding="{Binding ExtraInfo}" Width="*"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Кнопки управления -->
		<StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Right">
			<Button Content="Удалить выбранное" Width="150" Click="BtnDelete_Click" Background="#FFDDDD"/>
			<Button Content="Сохранить в JSON" Width="150" Margin="10,0,0,0" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>